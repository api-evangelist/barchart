{
  "opencollection": "1.0.0",
  "info": {
    "name": "Barchart OnDemand Commodities & Agriculture Weather API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Weather",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get weather",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ondemand.websol.barchart.com/getWeather.json",
            "params": [
              {
                "name": "apikey",
                "value": "",
                "type": "query",
                "description": "Barchart-issued API key."
              },
              {
                "name": "zipCode",
                "value": "60654",
                "type": "query"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Current conditions, forecasts, and maps by zip code."
        }
      ]
    }
  ],
  "bundled": true
}